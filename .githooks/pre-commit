#!/usr/bin/env bash
set -euo pipefail

# Pre-commit: test + build guard for Xcode project changes
# Blocks commit if files under the Xcode project folder changed and tests or build fails.
# Also warns about cross-platform implications for database schema changes.

changed=$(git diff --cached --name-only --diff-filter=ACMR || true)
if [[ -z "$changed" ]]; then
  exit 0
fi

# Cross-platform migration warning
if grep -q "DatabaseSchema.swift" <<< "$changed"; then
  echo ""
  echo "⚠️  [pre-commit] DATABASE SCHEMA CHANGE DETECTED"
  echo "    File: app/Sources/ContextifyCore/Database/DatabaseSchema.swift"
  echo ""
  echo "    Cross-platform considerations:"
  echo "    • Linux CLI uses the same schema (via ContextifyIngestionCore)"
  echo "    • After merging, verify Linux build: scripts/docker-linux-build.sh"
  echo "    • CI will automatically build on Linux: .github/workflows/linux-build.yml"
  echo ""
  echo "    Continuing with commit..."
  echo ""
fi

# Warn about changes to Linux-relevant files
if scripts/cross-platform-change-detect.sh HEAD~0 --quiet 2>/dev/null; then
  LINUX_CHANGES=$(scripts/cross-platform-change-detect.sh HEAD~0 2>/dev/null | grep -v "^Linux CLI changes" | grep -v "^Count:" | head -5 || true)
  if [[ -n "$LINUX_CHANGES" ]] && ! grep -q "DatabaseSchema.swift" <<< "$changed"; then
    echo ""
    echo "ℹ️  [pre-commit] Linux CLI files staged:"
    echo "$LINUX_CHANGES" | sed 's/^/    /'
    echo ""
  fi
fi

# Adjust this pattern if the project path changes
if ! grep -E '^(Contextify/)' >/dev/null <<< "$changed"; then
  exit 0
fi

if [[ ! -x scripts/xc.sh ]]; then
  echo "[pre-commit] scripts/xc.sh not found or not executable; skipping build check." >&2
  exit 0
fi

echo "[pre-commit] Xcode project changes detected. Running tests…"

# Run tests first - fail fast if tests don't pass
if ! swift test; then
  echo "[pre-commit] ❌ Tests failed. Fix tests before committing." >&2
  exit 1
fi

echo "[pre-commit] ✅ Tests passed. Running headless build (Xcode-beta if available)…"

# Prefer Xcode-beta automatically (handled by the script). Capture exit status.
# CTX_NO_RUN=1 skips launching the app after build (avoids Sparkle update modal)
if ! CTX_NO_RUN=1 bash scripts/xc.sh build; then
  echo "[pre-commit] Build failed. Commit aborted. See logs under build/logs/ and .xcresult in build/ResultBundles/." >&2
  exit 1
fi

echo "[pre-commit] Build succeeded. Proceeding with commit."
exit 0

